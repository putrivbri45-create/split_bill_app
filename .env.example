# Neon PostgreSQL Database Configuration Example
DATABASE_URL=postgresql://<user>:<password>@<host>/<database>?sslmode=require
DB_HOST=ep-small-poetry-b5qcodpq-pooler.c-7.us-east-2.aws.neon.tech
DB_PORT=5432
DB_NAME=neondb
DB_USER=neondb_owner
DB_PASSWORD=your_password_here
DB_SSL=true

# Security & App Preferences
APP_ENV=development
APP_NAME=Patungan
DEFAULT_CURRENCY=IDR
AUTH_TOKEN_KEY=patungan_jwt_token
REFRESH_TOKEN_KEY=patungan_refresh_token
